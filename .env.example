# Postgres connection (see db/sondar_schema.sql, db/000_extensions.sql, db/001_auth.sql)
DATABASE_URL=postgresql://sondar:sondar_dev_pw@localhost:5432/sondar

# Segunda camada de isolamento entre famílias (Row-Level Security, db/006_rls.sql):
# connection string do role restrito `sondar_app` (criado à mão — ver comentário
# no topo de db/006_rls.sql), usado por toda consulta de request real. Sem essa
# variável, a aplicação cai de volta em DATABASE_URL (sem RLS) — ok em dev antes
# de configurar o role, mas produção deve sempre ter DATABASE_URL_APP definida.
DATABASE_URL_APP=

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Etapa 0 seeds exactly the two household members from these env vars —
# there is no open signup. Change the passwords before running db:seed.
HOUSEHOLD_NAME=Minha família
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER1_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
SEED_USER2_NAME=

# services/ai/* (Etapa 3+)
ANTHROPIC_API_KEY=

# Cadastro de conta (Multi-Família): emails de confirmação e redefinição de
# senha via Resend (resend.com). Sem RESEND_API_KEY, o email é só impresso
# no console — útil em dev, mas configure antes de qualquer usuário real.
RESEND_API_KEY=
EMAIL_FROM=Sondar <onboarding@resend.dev>

# Base usada para montar os links de confirmação/redefinição enviados por
# email. Em produção, a URL real do site (ex: https://sondar.app).
APP_URL=http://localhost:3000

# Protects /api/cron/advance-installments (Etapa 4) — Vercel Cron sends this
# as "Authorization: Bearer <value>" automatically once set here AND in the
# Vercel project's env vars; the route refuses every request without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
